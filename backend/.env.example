# Bu dosyayı `.env` adıyla kopyala ve değerleri kendi hesabından doldur.
# `.env` git'e girmez; gerçek değerleri (şifre, bağlantı adresi) bu dosyaya yazma.

# Neon (veya başka bir PostgreSQL) bağlantı adresi.
# Neon panelinde: Connect > Connection string. Sonunda `?sslmode=verify-full` olmalı
# (`require` da çalışır ama `pg` uyarı basar).
# Bookpal henüz veritabanı kullanmıyor (veri bellekte); bu satır veritabanı adımı için hazır duruyor.
DATABASE_URL=

# Aşağıdakiler isteğe bağlı; boşsa kodun varsayılanı geçerli. Değiştirmek için başındaki # işaretini kaldır.
# Sunucunun portu (varsayılan 3000).
# PORT=3000
# `production` yazılırsa demo hesaplar kapanır ve /docs (Swagger) açılmaz.
# NODE_ENV=development
# Demo hesaplar (elif@bookpal.demo, mert@bookpal.demo): `true` açar, `false` kapatır.
# DEMO_ACCOUNTS_ENABLED=true
